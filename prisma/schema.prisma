  approvedAt      DateTime?
  approvalNote    String?
  reopenedByName  String?
  reopenedAt      DateTime?
  reopenReason    String?
  notes           String?
  billsCount      Int      @default(0)
  paymentsCount   Int      @default(0)
  totalExpected   Float    @default(0)
  totalActual     Float    @default(0)
