  @@index([userId])
  @@index([closureDate])
}

model DrawerAuditLog {
  id              String   @id @default(cuid())
  userDayClosureId String?
  userId          String?
  userName        String?
  action          String   // closed | mismatch_detected | approved | reopened
  details         String?  // JSON
  createdAt       DateTime @default(now())
}

// ============================================================
// STAFF (HR)
// ============================================================
model Staff {
  id              String   @id @default(cuid())
  staffId         String   @unique // EMP-####
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  role            String   @default("other") // receptionist | lab-technician | radiologist | phlebotomist | doctor | nurse | manager | accountant | cleaner | security | other
  department      String?
  joiningDate     String?  // YYYY-MM-DD
  baseSalary      Float    @default(0)
  address         String?
  emergencyContact String?
  bankAccount     String?
  ifsc            String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  advances        StaffAdvance[]
  salaryPayments  StaffSalaryPayment[]
  attendance      StaffAttendance[]
}

model StaffAdvance {
  id              String   @id @default(cuid())
  staffId         String
  amount          Float
  advanceDate     String   // YYYY-MM-DD
  paymentMode     String   @default("cash")
  reason          String?
  recoveredAmount Float    @default(0)
  status          String   @default("outstanding") // outstanding | cleared
  createdAt       DateTime @default(now())

  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffSalaryPayment {
  id              String   @id @default(cuid())
  staffId         String
  monthYear       String   // YYYY-MM
  baseAmount      Float
  bonus           Float    @default(0)
  deductions      Float    @default(0)
  advanceDeducted Float    @default(0)
  daysPresent     Int?
  daysAbsent      Int?
  netAmount       Float
  paymentDate     String   // YYYY-MM-DD
  paymentMode     String   @default("cash")
  reference       String?
  paidById        String?
  createdAt       DateTime @default(now())

  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  paidBy          User?    @relation("SalaryPaidBy", fields: [paidById], references: [id])

  @@index([staffId])
  @@index([monthYear])
}

model StaffAttendance {
  id              String   @id @default(cuid())
  staffId         String
  attendanceDate  String   // YYYY-MM-DD
  punchIn         DateTime?
  punchOut        DateTime?
  source          String   @default("manual") // manual | biometric | webauthn
  notes           String?
  createdAt       DateTime @default(now())

  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, attendanceDate])
  @@index([staffId])
  @@index([attendanceDate])
}

model StaffCounter {
  id              Int      @id @default(1)
  counter         Int      @default(0)
}

// ============================================================
// REPORT TEMPLATES + REPORTS (lab/pathology reports — not financial)
// ============================================================
model ReportTemplate {
  id              String   @id @default(cuid())
  name            String   @unique
  testId          String?  // Optional link to Test
  testName        String
  category        String   @default("general") // hematology | biochemistry | microbiology | pathology | cardiology | general
  template        String   // JSON: { fields: [{name, type, unit, refRange, defaultValue}] }
  defaultValues   String?  // JSON of pre-filled values
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PatientReport {
  id              String   @id @default(cuid())
  reportNumber    String   @unique // RPT-YYYYMM-####
  billId          String?
  billNumber      String?
  patientId       String?
  patientName     String
  patientAge      Int?
  patientGender   String?
  patientPhone    String?
  doctorName      String?
  testId          String?
  testName        String
  templateId      String?
  values          String   // JSON: { fieldName: value }
  notes           String?
  impression      String?
  status          String   @default("draft") // draft | pending_review | approved | delivered | cancelled
  reportedById    String?
  reportedByName  String?
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  deliveredAt     DateTime?
  deliveryMethod  String?  // whatsapp | email | portal | print | none
