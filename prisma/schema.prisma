  timeSlot        String   // HH:MM
  durationMin     Int      @default(30)
  status          String   @default("booked") // booked | arrived | in-progress | completed | cancelled | no-show
  notes           String?
  source          String   @default("walk-in") // walk-in | phone | online | whatsapp
  isFasting       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
  @@index([patientPhone])
}

model AppointmentCounter {
  id              Int      @id @default(1)
  dateStr         String   @unique // YYYYMMDD
  counter         Int      @default(0)
}

// ============================================================
// NOTIFICATIONS (WhatsApp/SMS/Email queue + history)
// ============================================================
model Notification {
  id              String   @id @default(cuid())
  channel          String  // whatsapp | sms | email
  recipientPhone  String?
  recipientEmail  String?
  recipientName   String?
  templateName    String   // report_ready | appointment_reminder | payment_link | daily_summary | otp
