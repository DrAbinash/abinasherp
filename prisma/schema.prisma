  provider        String   @default("gupshup") // gupshup | interakt | wati | twilio | meta
  apiKey          String   @default("")
  apiSecret       String   @default("")
  phoneNumber     String   @default("") // Sender phone (with country code, no +)
  templateNamespace String @default("") // For template message IDs
