  status          String   @default("queued") // queued | sent | failed | delivered
  externalId      String?  // Provider message ID
  errorMessage    String?
  billId          String?
  reportId        String?
  appointmentId   String?
  sentById        String?
  sentByName      String?
  attempts        Int      @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
