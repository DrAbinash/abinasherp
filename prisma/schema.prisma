// ============================================================
// CORPORATE / TPA BILLING
// ============================================================
model Corporate {
  id              String   @id @default(cuid())
  corporateId     String   @unique // CORP-####
  name            String
  type            String   @default("corporate") // corporate | tpa | insurance
  contactPerson   String?
  phone           String?
  email           String?
  gstin           String?
  pan             String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  creditTermsDays Int      @default(30) // payment due in N days
  creditLimit     Float    @default(0) // 0 = unlimited
  outstandingBalance Float  @default(0) // running balance
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rateCards       CorporateRateCard[]
  patients        CorporatePatient[]
  invoices        CorporateInvoice[]

  @@index([name])
  @@index([type])
}

model CorporateRateCard {
  id              String   @id @default(cuid())
  corporateId     String
  testId          String
  negotiatedPrice Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  corporate       Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, testId])
  @@index([corporateId])
}

model CorporatePatient {
  id              String   @id @default(cuid())
  corporateId     String
  patientId       String
  employeeId      String?  // Employee ID at the corporate
  relation        String   @default("self") // self | spouse | child | parent
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  corporate       Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, patientId])
  @@index([corporateId])
}

model CorporateInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // INV-CORP-YYYYMM-####
  corporateId     String
  corporateName   String
  periodFrom      String   // YYYY-MM-DD
  periodTo        String
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  billCount       Int      @default(0)
  status          String   @default("raised") // raised | partial | paid | overdue
  dueDate         String   // YYYY-MM-DD
  generatedAt     DateTime @default(now())
  paidAt          DateTime?
  notes           String?
  billIds         String?  // JSON array of bill IDs in this invoice
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  corporate       Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@index([corporateId])
  @@index([status])
}

model CorporateInvoiceCounter {
  id              Int      @id @default(1)
  yearMonth       String   @unique
  counter         Int      @default(0)
}
