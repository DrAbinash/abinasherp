# Care ERP — Synology / Container Manager .env
# Generated ready-to-deploy. Credentials below are freshly generated & strong.
# NOTE: this file was committed for convenience — delete it from the repo after
# pulling on the NAS. Live ICICI payment keys are intentionally left blank; paste
# them into this file on the NAS only (keep payment secrets out of git history).

# Web port (host side). Reverse-proxy /erp -> http://<nas-ip>:HOST_PORT
HOST_PORT=3000

# PostgreSQL (compose builds DATABASE_URL from these)
DB_USER=careerp
DB_PASSWORD=lE1pwbtu6Pvr5hxt0H93cpfGXbjG
DB_NAME=careerp

# Bootstrap super-admin (first run only; forced PIN change on first login)
BOOTSTRAP_ADMIN_PIN=ukju8VSv9XmtChc9
BOOTSTRAP_ADMIN_EMAIL=admin@yourclinic.com
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
CLINIC_NAME=Care Diagnostic Centre

# DB identity guard (refuses to migrate against the wrong database)
APP_NAME=care-erp
APP_ENVIRONMENT=production

# Public URL (scheme + host + /erp) — set to your real domain before going live.
PUBLIC_BASE_URL=https://your-domain.com/erp

# ICICI Orange Pay — LEFT BLANK ON PURPOSE. Paste your live keys here on the NAS
# only (never commit them). Booking falls back to pay-at-centre while blank.
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_SECRET_KEY=
# ICICI_BASE_URL=https://pgpay.icicibank.com

# Optional super-admin USB-key gating (blank = disabled)
SUPER_ADMIN_USB_KEY=
SUPER_ADMIN_USB_PIN=
