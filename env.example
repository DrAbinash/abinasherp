# Care ERP — Production Environment (PostgreSQL / Synology)
# Copy this file to `env` (no leading dot) alongside docker-compose.yml.
# Both the `db` and `care-erp` containers read this same file.

# ============================================================
# PostgreSQL — used by BOTH the db container and the app.
# Keep POSTGRES_* and DATABASE_URL in sync (same user/password/db name).
# The host in DATABASE_URL is the compose service name: `db`.
# ============================================================
POSTGRES_USER=careerp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=careerp
DATABASE_URL=postgresql://careerp:CHANGE_ME_strong_db_password@db:5432/careerp?schema=public

# ============================================================
# Bootstrap super-admin (created only on first run when DB is empty).
# In production BOOTSTRAP_ADMIN_PIN is REQUIRED — the app refuses to
# bootstrap without it. The admin is forced to change the PIN on first login.
# ============================================================
BOOTSTRAP_ADMIN_EMAIL=admin@yourclinic.com
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
BOOTSTRAP_ADMIN_PIN=CHANGE_ME_strong_admin_pin

# Clinic identity
CLINIC_NAME=Care Diagnostic Centre
CLINIC_ADDRESS=Main Road, City
CLINIC_PHONE=+91-9876543210
CLINIC_EMAIL=info@yourclinic.com

# ============================================================
# App base path & public URL
# NEXT_PUBLIC_BASE_PATH is baked at BUILD time (see docker-compose build args);
# this runtime copy is only used by the healthcheck and server. Keep it = /erp.
# ============================================================
NEXT_PUBLIC_BASE_PATH=/erp
# The externally-reachable base URL (scheme + host + /erp) — used for links and
# as the ICICI returnURL/webhook host. MUST be whitelisted in ICICI dashboard.
PUBLIC_BASE_URL=https://your-domain.com/erp

# Optional: Super-admin USB-key gating (leave blank to disable)
# SUPER_ADMIN_USB_KEY=
# SUPER_ADMIN_USB_PIN=

# ============================================================
# ICICI Orange Pay — Online booking payment gateway (optional).
# If unset, online booking falls back to pay-at-centre.
# ============================================================
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_SECRET_KEY=
# Optional base URL override (defaults: UAT unless NODE_ENV=production)
# ICICI_BASE_URL=

NODE_ENV=production
