# Care ERP — Production Environment
# Copy this file to `env` (no leading dot) on your Synology NAS,
# placed alongside docker-compose.yml in /volume1/docker/care-erp/

# Database — SQLite file inside the container's /app/data volume
DATABASE_URL=file:/app/data/care-erp.db

# Bootstrap super-admin (only used on first run when DB is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@yourclinic.com
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
BOOTSTRAP_ADMIN_PIN=ChangeMe123!

# Clinic identity
CLINIC_NAME=Care Diagnostic Centre
CLINIC_ADDRESS=Main Road, City
CLINIC_PHONE=+91-9876543210
CLINIC_EMAIL=info@yourclinic.com

# Optional: Super-admin USB key gating
# Generate a strong random string and place the SAME string in a file
# called `superadmin.key` on a USB drive. When the drive is inserted,
# the super-admin portal reads the file and sends it as `X-SA-USB-Key` header.
# Leave blank to disable USB gating (less secure, but easier for initial setup).
# SUPER_ADMIN_USB_KEY=
# SUPER_ADMIN_USB_PIN=

# NextAuth (used for session signing — generate a random 32-char string)
NEXTAUTH_URL=http://your-synology-ip:3000
NEXTAUTH_SECRET=replace-with-random-32-char-string

# Production
NODE_ENV=production
