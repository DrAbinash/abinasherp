# Care ERP — Synology / Container Manager environment
#
# IMPORTANT: copy this file to a file named exactly `.env` in the same folder
# as docker-compose.yml. Compose auto-loads `.env` for ${VAR} interpolation.
# `.env` is git-ignored and excluded from the Docker image — secrets stay out
# of the repo and the built image.

# -----------------------------------------------------------------------------
# Web port (host side). Reverse-proxy /erp -> http://<nas-ip>:HOST_PORT
# -----------------------------------------------------------------------------
HOST_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL — compose builds DATABASE_URL from these (one source of truth).
# Use a URL-safe password (letters/digits/-_. ) to avoid escaping issues.
# -----------------------------------------------------------------------------
DB_USER=careerp
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=careerp

# -----------------------------------------------------------------------------
# Bootstrap super-admin (created only on first run when the DB is empty).
# REQUIRED — compose refuses to start if BOOTSTRAP_ADMIN_PIN is unset. The
# admin is forced to change the PIN on first login.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_PIN=CHANGE_ME_strong_admin_pin
BOOTSTRAP_ADMIN_EMAIL=admin@yourclinic.com
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
CLINIC_NAME=Care Diagnostic Centre

# DB identity guard — the migrate service refuses to run migrations against a
# database stamped with a different app/environment (wrong-DATABASE_URL guard).
APP_NAME=care-erp
APP_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Public URL (scheme + host + /erp). Used for links and as the ICICI
# returnURL/webhook host — MUST be whitelisted in the ICICI dashboard.
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://your-domain.com/erp

# -----------------------------------------------------------------------------
# ICICI Orange Pay (optional — booking falls back to pay-at-centre if unset).
# Leave ICICI_URL_PREFIX-style suffixes OUT: the code appends /pg/api/v2/... itself.
# -----------------------------------------------------------------------------
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_SECRET_KEY=
# Optional base URL override (defaults to UAT unless NODE_ENV=production)
# ICICI_BASE_URL=https://pgpay.icicibank.com

# -----------------------------------------------------------------------------
# Optional super-admin USB-key gating (leave blank to disable)
# -----------------------------------------------------------------------------
SUPER_ADMIN_USB_KEY=
SUPER_ADMIN_USB_PIN=
